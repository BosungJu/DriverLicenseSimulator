--- !u!114 &990254349
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 990254345}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4c336542b994d5144aa77773a4310645, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  drivingTestLevel: {fileID: 1093489014}
  popupPanel: {fileID: 608476783}
  guideText: {fileID: 895706495}
  displaySeconds: 4
  commandGuides:
  - commandName: start
    stepIndex: -1
    message: "\uAE30\uB2A5\uC2DC\uD5D8\uC744 \uC2DC\uC791\uD569\uB2C8\uB2E4. \uC548\uC804\uB760\uB97C
      \uB9E4\uACE0 \uC2DC\uB3D9\uC744 \uAC74 \uB4A4\n\uBC29\uD5A5\uC9C0\uC2DC\uB4F1\uC744
      \uCF1C\uACE0 30\uCD08 \uC548\uC5D0 \uCD9C\uBC1C\uD558\uC138\uC694."
  - commandName: hill
    stepIndex: -1
    message: "\uACBD\uC0AC\uB85C \uAD6C\uAC04\uC785\uB2C8\uB2E4.\n\uC815\uC9C0 \uAD6C\uAC04\uC5D0
      \uC815\uCC28\uD55C \uB4A4 \uB4A4\uB85C \uBC00\uB9AC\uC9C0 \uC54A\uAC8C \uCD9C\uBC1C\uD558\uC138\uC694."
  - commandName: hill
    stepIndex: 0
    message: "\uACBD\uC0AC\uB85C \uAD6C\uAC04\uC785\uB2C8\uB2E4.\n\uC815\uC9C0 \uAD6C\uAC04\uAE4C\uC9C0
      \uCC9C\uCC9C\uD788 \uC62C\uB77C\uAC00\uC138\uC694."
  - commandName: hill
    stepIndex: 1
    message: "\uACBD\uC0AC\uB85C \uC815\uC9C0 \uAD6C\uAC04\uC785\uB2C8\uB2E4. \uC644\uC804\uD788
      \uC815\uCC28\uD55C \uB4A4\n30\uCD08 \uC548\uC5D0 \uB4A4\uB85C \uBC00\uB9AC\uC9C0
      \uC54A\uAC8C \uCD9C\uBC1C\uD558\uC138\uC694."
  - commandName: hill
    stepIndex: 2
    message: "\uACBD\uC0AC\uB85C\uB97C \uD1B5\uACFC\uD588\uC2B5\uB2C8\uB2E4.\n\uC18D\uB3C4\uB97C
      \uC904\uC774\uBA70 \uCC9C\uCC9C\uD788 \uB0B4\uB824\uAC00\uC138\uC694."
  - commandName: left
    stepIndex: -1
    message: "\uC88C\uD68C\uC804\uD558\uC138\uC694.\n\uC88C\uCE21 \uBC29\uD5A5\uC9C0\uC2DC\uB4F1\uC744
      \uCF1C\uACE0 \uC9C4\uD589\uD558\uC138\uC694."
  - commandName: right
    stepIndex: -1
    message: "\uC6B0\uD68C\uC804\uD558\uC138\uC694.\n\uC6B0\uCE21 \uBC29\uD5A5\uC9C0\uC2DC\uB4F1\uC744
      \uCF1C\uACE0 \uC9C4\uD589\uD558\uC138\uC694."
  - commandName: signal
    stepIndex: -1
    message: "\uC2E0\uD638\uAD50\uCC28\uB85C\uC785\uB2C8\uB2E4. \uC2E0\uD638\uB97C
      \uC9C0\uD0A4\uACE0 \uC55E \uBC94\uD37C\uAC00\n\uC815\uC9C0\uC120\uC744 \uB118\uC9C0
      \uC54A\uAC8C \uD558\uC138\uC694. 20\uCD08 \uC774\uC0C1 \uC11C \uC788\uC9C0
      \uB9C8\uC138\uC694."
  - commandName: t_test
    stepIndex: -1
    message: "\uC9C1\uAC01\uC8FC\uCC28 \uAD6C\uAC04\uC785\uB2C8\uB2E4.\n\uAC80\uC9C0\uC120\uC744
      \uBC1F\uC9C0 \uC54A\uACE0 \uC8FC\uCC28\uD55C \uB4A4 \uC8FC\uCC28 \uBE0C\uB808\uC774\uD06C\uB97C
      \uCC44\uC6B0\uC138\uC694."
  - commandName: t_test
    stepIndex: 0
    message: "\uC9C1\uAC01\uC8FC\uCC28 \uAD6C\uAC04\uC785\uB2C8\uB2E4.\n120\uCD08
      \uC548\uC5D0 \uAC80\uC9C0\uC120\uC744 \uBC1F\uC9C0 \uC54A\uACE0 \uC8FC\uCC28\uD558\uC138\uC694."
  - commandName: t_test
    stepIndex: 1
    message: "\uD6C4\uC9C4\uD558\uC5EC \uD655\uC778\uC120\uAE4C\uC9C0 \uCC28\uACE0\uC5D0
      \uB123\uC73C\uC138\uC694.\n\uBC14\uD034\uAC00 \uAC80\uC9C0\uC120\uC5D0 \uB2FF\uC9C0
      \uC54A\uAC8C \uC8FC\uC758\uD558\uC138\uC694."
  - commandName: t_test
    stepIndex: 2
    message: "\uC8FC\uCC28 \uBE0C\uB808\uC774\uD06C\uB97C \uCC44\uC6E0\uB2E4\uAC00
      \uD480\uACE0\n\uC804\uC9C4\uD558\uC5EC \uCC28\uACE0\uB97C \uBE60\uC838\uB098\uC624\uC138\uC694."
  - commandName: t_test
    stepIndex: 3
    message: "\uC9C1\uAC01\uC8FC\uCC28 \uAD6C\uAC04\uC744 \uD1B5\uACFC\uD588\uC2B5\uB2C8\uB2E4.\n\uB2E4\uC74C
      \uCF54\uC2A4\uB85C \uC9C4\uD589\uD558\uC138\uC694."
  - commandName: fast
    stepIndex: -1
    message: "\uAC00\uC18D \uAD6C\uAC04\uC785\uB2C8\uB2E4.\n\uC2DC\uC18D 20km \uC774\uC0C1\uC73C\uB85C
      \uAC00\uC18D\uD55C \uB4A4 \uAC10\uC18D\uD558\uC138\uC694."
  - commandName: on_emergency
    stepIndex: -1
    message: "\uB3CC\uBC1C \uC0C1\uD669\uC785\uB2C8\uB2E4! 2\uCD08 \uC548\uC5D0 \uC815\uC9C0\uD558\uACE0\n3\uCD08
      \uC548\uC5D0 \uBE44\uC0C1\uB4F1\uC744 \uCF20 \uB4A4, \uB044\uACE0 \uCD9C\uBC1C\uD558\uC138\uC694."
  - commandName: end
    stepIndex: -1
    message: "\uC885\uB8CC \uC9C0\uC810\uC785\uB2C8\uB2E4.\n\uC2DC\uD5D8 \uACB0\uACFC\uB97C
      \uD655\uC778\uD558\uC138\uC694."
  finishApproachMessage: "\uACE7 \uC885\uB8CC \uC9C0\uC810\uC785\uB2C8\uB2E4. \uBC29\uD5A5\uC9C0\uC2DC\uB4F1\uC744
    \uCF1C\uACE0 \uB3C4\uCC29\uD558\uC138\uC694."
